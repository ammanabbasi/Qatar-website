# ============================================
# ABK Trading & Service — environment variables
# ============================================
# Copy this file to `.env.local` for local dev. Vercel env vars are set in the
# project dashboard, NOT in this file — `.env*.local` is gitignored.
#
# NEXT_PUBLIC_* vars are inlined at build time (public to the browser).
# Non-public secrets should never be prefixed NEXT_PUBLIC_.

# -------- Canonical site URL --------
# Used for canonical URLs, hreflang alternates, sitemap.xml, robots.txt, JSON-LD.
# Production: leave unset OR set to the prod URL.
# Preview: leave unset so canonical still points to prod (preview URLs should
# not be indexed).
NEXT_PUBLIC_SITE_URL=https://abktradingservice.com

# -------- Plausible Analytics --------
# Set only in production. If unset, the Plausible script is NOT rendered —
# this prevents localhost/preview traffic from polluting production stats.
# To disable analytics entirely, simply leave unset.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=abktradingservice.com

# -------- Google Analytics 4 (GA4) --------
# Measurement ID from GA4 web data stream (default G-TYPKQ6L3SB).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TYPKQ6L3SB

# Set to 1 to force GA4 / Google Ads tracking on localhost during development:
# NEXT_PUBLIC_GA_FORCE_TRACKING=1
# NEXT_PUBLIC_ADS_FORCE_TRACKING=1
